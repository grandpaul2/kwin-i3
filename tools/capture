#!/usr/bin/env bash
# Meta+Shift+B on the live desktop: save what led up to something that looked wrong, so it can
# become a test later (docs/debugging.md). The press is the directory's name, to the millisecond.
#   ~/.local/state/kwin-i3/captures/<time>/state.txt   kwin-i3's "Dump State": outputs, every
#                                                      workspace's tree, every window, and (== log)
#                                                      its last 2000 log lines, to the millisecond
#   .../hold.txt      kwini3hold's last 500 events (holds, closes kept, snapshots), when it's loaded
#   .../pointer.txt   kwini3helper's last 1000 presses and pointer crossings (pointerprobe.h)
#   .../screen.png    both monitors, a second or so after the press
#   .../note.txt      what the user typed in the box that opens after the save (empty or missing: none)
# tools/capture-read DIR prints the two logs as one timeline around the press: read that first.
# KI3_CAPTURE_DIR overrides the parent directory (the live test uses it). Inside the test KWin
# (KI3_INNER=1) the screenshot and the note box are skipped: the screenshot would be the live
# desktop's, and nobody is there to type.
# Captions and the screenshot can be private: the directory is mode 700.
set -uo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
parent=${KI3_CAPTURE_DIR:-$HOME/.local/state/kwin-i3/captures}
mkdir -p -m 700 "$parent"
# Never more than 15 s, and one at a time (a double press would race for the sink's name).
# The timeout re-exec comes first: it would inherit the lock and then find it taken.
[[ ${KI3_CAPTURE_TIMED:-} == 1 ]] || KI3_CAPTURE_TIMED=1 exec timeout 15 "$0" "$@"
exec 9>"$parent/.lock"
flock -n 9 || exit 0
dir=$parent/$(date +%Y-%m-%d_%H%M%S.%3N)
mkdir -m 700 "$dir"
state=$dir/state.txt

"$here/logsink.py" "$state" net.local.kwini3.dump &
sink=$!
trap 'kill $sink 2>/dev/null' EXIT
for _ in $(seq 40); do busctl --user status net.local.kwini3.dump >/dev/null 2>&1 && break; sleep 0.05; done

timeout 5 busctl --user call org.kde.kglobalaccel /component/kwin org.kde.kglobalaccel.Component \
    invokeShortcut s "kwin-i3 Dump State" >/dev/null 2>&1
for _ in $(seq 40); do grep -q 'DUMP END$' "$state" 2>/dev/null && break; sleep 0.05; done
grep -q 'DUMP END$' "$state" 2>/dev/null || echo "capture: kwin-i3 did not answer (not loaded?)" >> "$dir/errors.txt"

timeout 5 busctl --user --json=short call org.kde.KWin /kwini3hold net.local.kwini3hold Events 2>/dev/null |
    python3 -c 'import json, sys; print("\n".join(json.load(sys.stdin)["data"][0]))' > "$dir/hold.txt" 2>/dev/null ||
    rm -f "$dir/hold.txt"
timeout 5 busctl --user --json=short call org.kde.KWin /kwini3helper/pointer net.local.kwini3helper.Pointer Events 2>/dev/null |
    python3 -c 'import json, sys; print("\n".join(json.load(sys.stdin)["data"][0]))' > "$dir/pointer.txt" 2>/dev/null ||
    rm -f "$dir/pointer.txt"

if [[ ${KI3_INNER:-} != 1 ]]; then
    timeout 10 spectacle -b -n -f -o "$dir/screen.png" >/dev/null 2>&1
    # Its own session: outlives the 15 s cap and the lock (a second press can save meanwhile).
    # kwin-i3 floats it by its title (src/rules.js).
    setsid -f bash -c 'kdialog --title "kwin-i3 capture note" --inputbox "What went wrong? (optional; Esc for none)" > "$1/note.txt" 2>/dev/null' _ "$dir" 9>&-
fi
exit 0
