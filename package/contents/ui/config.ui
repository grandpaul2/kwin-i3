     <item row="41" column="1">
      <widget class="QComboBox" name="kcfg_mouseWarping">
       <property name="kcfg_property" stdset="0">
        <cstring>currentText</cstring>
       </property>
       <property name="toolTip">
        <string>i3's mouse_warping. output: when the focus moves to another output (a key, a workspace switch, an activation), the pointer goes to the focused window's centre, unless it is on that output already. none: the pointer never moves by itself.</string>
       </property>
       <item>
        <property name="text">
         <string>output</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>none</string>
        </property>
       </item>
      </widget>
