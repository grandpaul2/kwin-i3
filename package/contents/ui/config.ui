     <item row="10" column="1">
      <widget class="QCheckBox" name="kcfg_workspaceAutoBackAndForth">
       <property name="text">
        <string>Pressing the current workspace's key returns to the previous one</string>
       </property>
       <property name="toolTip">
        <string>i3's workspace_auto_back_and_forth: Meta+N for the focused workspace shows the one focused before, and Meta+Shift+N sends the window there.</string>
