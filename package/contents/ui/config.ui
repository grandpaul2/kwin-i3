<?xml version="1.0" encoding="UTF-8"?>
<!-- kwin-i3's settings form (KWin's generic scripted KCM). Plain Qt widgets only: QUiLoader
     needs no designer plugin for them. Each kcfg_<name> is an entry of ../config/main.xml.
     Laid out as Plasma's own pages are (docs/spec-settings-page.md, "The tidied form"): one
     centred form, so every label shares one right-aligned column, and bold section headings
     instead of group boxes. -->
<ui version="4.0">
 <class>KWinI3ConfigForm</class>
 <widget class="QWidget" name="KWinI3ConfigForm">
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QLabel" name="applyHint">
     <property name="text">
      <string>With the kwin-i3 plugins installed, Apply takes effect at once. Without them, press Meta+Shift+C after Apply.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="alignment">
      <set>Qt::AlignHCenter</set>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QFormLayout" name="form">
     <property name="formAlignment">
      <set>Qt::AlignHCenter|Qt::AlignTop</set>
     </property>
     <property name="labelAlignment">
      <set>Qt::AlignRight|Qt::AlignVCenter</set>
     </property>
     <property name="fieldGrowthPolicy">
      <enum>QFormLayout::FieldsStayAtSizeHint</enum>
     </property>
     <item row="0" column="0" colspan="2">
      <widget class="QLabel" name="layoutHeading">
       <property name="text">
        <string>Tiling</string>
       </property>
       <property name="font">
        <font>
         <bold>true</bold>
        </font>
       </property>
       <property name="alignment">
        <set>Qt::AlignHCenter</set>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="gapsInnerLabel">
       <property name="text">
        <string>Gap between windows:</string>
       </property>
       <property name="buddy">
        <cstring>kcfg_gapsInner</cstring>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QSpinBox" name="kcfg_gapsInner">
       <property name="suffix">
        <string> px</string>
       </property>
       <property name="maximum">
        <number>100</number>
       </property>
       <property name="singleStep">
        <number>2</number>
       </property>
       <property name="toolTip">
        <string>i3's gaps inner: the space between two tiled windows. Even: an odd number counts as the one below.</string>
       </property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="gapsOuterLabel">
       <property name="text">
        <string>Extra gap at screen edges:</string>
       </property>
       <property name="buddy">
        <cstring>kcfg_gapsOuter</cstring>
       </property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QSpinBox" name="kcfg_gapsOuter">
       <property name="suffix">
        <string> px</string>
       </property>
       <property name="maximum">
        <number>200</number>
       </property>
       <property name="toolTip">
        <string>i3's gaps outer: added to the gap between windows at the screen's edge.</string>
       </property>
      </widget>
     </item>
     <item row="3" column="0">
      <widget class="QLabel" name="defaultOrientationLabel">
       <property name="text">
