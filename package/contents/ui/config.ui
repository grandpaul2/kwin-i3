       <property name="suffix">
        <string> ms</string>
       </property>
       <property name="minimum">
        <number>10</number>
       </property>
       <property name="maximum">
        <number>2000</number>
       </property>
       <property name="toolTip">
        <string>How long to wait for a slow window before showing the new layout anyway.</string>
       </property>
      </widget>
     </item>
