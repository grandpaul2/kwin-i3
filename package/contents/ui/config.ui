     </item>
     <item row="11" column="1">
      <widget class="QLineEdit" name="kcfg_workspaceOutputs">
       <property name="minimumSize">
        <size>
         <width>360</width>
         <height>0</height>
        </size>
       </property>
       <property name="placeholderText">
        <string>1=DP-4, 2=DP-6</string>
       </property>
       <property name="toolTip">
        <string>i3's "workspace N output X": a workspace lives on that monitor, by its connector name (kscreen-doctor -o lists them). Applies at login, when the monitor appears, and to a workspace first used after the change. Unlisted workspaces: 1 on the primary monitor, then the next free one.</string>
       </property>
      </widget>
     </item>
