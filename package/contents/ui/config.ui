<?xml version="1.0" encoding="UTF-8"?>
<!-- kwin-i3's settings form (KWin's generic scripted KCM). Plain Qt widgets only: QUiLoader
     needs no designer plugin for them. Each kcfg_<name> is an entry of ../config/main.xml. -->
<ui version="4.0">
 <class>KWinI3ConfigForm</class>
 <widget class="QWidget" name="KWinI3ConfigForm">
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QLabel" name="applyHint">
     <property name="text">
      <string>Changes apply when you press Meta+Shift+C (kwin-i3's reload, as in i3), or at the next login.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="layoutGroup">
     <property name="title">
      <string>Layout and focus</string>
     </property>
     <layout class="QFormLayout" name="layoutLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="defaultOrientationLabel">
        <property name="text">
         <string>New workspaces split:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="kcfg_defaultOrientation">
        <property name="kcfg_property" stdset="0">
         <cstring>currentText</cstring>
        </property>
        <property name="toolTip">
         <string>i3's default_orientation. auto: side by side, unless the monitor is taller than wide. Applies to workspaces created after the change.</string>
        </property>
        <item>
         <property name="text">
          <string>auto</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>horizontal</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>vertical</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="resizeStepLabel">
        <property name="text">
         <string>Resize step (Meta+Ctrl+arrows):</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="kcfg_resizeStep">
        <property name="suffix">
         <string> %</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>50</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="focusWrappingLabel">
        <property name="text">
         <string>Focus wrapping:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QComboBox" name="kcfg_focusWrapping">
        <property name="kcfg_property" stdset="0">
         <cstring>currentText</cstring>
        </property>
        <property name="toolTip">
         <string>i3's focus_wrapping. yes: at the edge, to the next monitor, else wrap around. no: never wrap, but cross to the next monitor. force: always wrap inside the container. workspace: wrap, never leave the workspace.</string>
        </property>
        <item>
         <property name="text">
          <string>yes</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>no</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>force</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>workspace</string>
         </property>
        </item>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="workspacesGroup">
     <property name="title">
      <string>Workspaces</string>
     </property>
     <layout class="QFormLayout" name="workspacesLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="workspaceOutputsLabel">
        <property name="text">
         <string>Workspace on monitor:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="kcfg_workspaceOutputs">
        <property name="placeholderText">
         <string>1=DP-4, 2=DP-6</string>
        </property>
        <property name="toolTip">
         <string>i3's "workspace N output X": a workspace lives on that monitor, by its connector name (kscreen-doctor -o lists them). Applies at login, when the monitor appears, and to a workspace first used after the change. Unlisted workspaces: 1 on the primary monitor, then the next free one.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="rulesGroup">
     <property name="title">
      <string>Window rules (comma-separated)</string>
     </property>
     <layout class="QFormLayout" name="rulesLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="ignoreClassLabel">
        <property name="text">
         <string>Never manage these window classes:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="kcfg_ignoreClass"/>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="ignoreRoleLabel">
        <property name="text">
         <string>Never manage these window roles:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="kcfg_ignoreRole"/>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="floatingClassLabel">
        <property name="text">
         <string>Float these window classes:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="kcfg_floatingClass"/>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="floatingTitleLabel">
        <property name="text">
         <string>Float windows whose title contains:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QLineEdit" name="kcfg_floatingTitle"/>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="kcfg_debugLog">
     <property name="text">
      <string>Debug log (every action, over D-Bus to tools/logsink.py; for bug reports)</string>
     </property>
    </widget>
   </item>
   <item>
    <spacer name="bottomSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
