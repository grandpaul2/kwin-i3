       <property name="suffix">
        <string> px</string>
       </property>
       <property name="minimum">
        <number>1</number>
       </property>
       <property name="maximum">
        <number>200</number>
       </property>
       <property name="toolTip">
        <string>How far one press of Meta+Shift+arrow moves, or Meta+Ctrl+arrow resizes, a floating window.</string>
       </property>
      </widget>
     </item>
     <item row="6" column="0">
      <widget class="QLabel" name="focusWrappingLabel">
       <property name="text">
        <string>Focus at an edge:</string>
       </property>
       <property name="buddy">
        <cstring>kcfg_focusWrapping</cstring>
       </property>
      </widget>
     </item>
     <item row="6" column="1">
      <widget class="QComboBox" name="kcfg_focusWrapping">
       <property name="kcfg_property" stdset="0">
        <cstring>currentText</cstring>
       </property>
       <property name="toolTip">
        <string>i3's focus_wrapping. yes: at the edge, to the next monitor, else wrap around. no: never wrap, but cross to the next monitor. force: always wrap inside the container. workspace: wrap, never leave the workspace.</string>
       </property>
       <item>
        <property name="text">
         <string>yes</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>no</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>force</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>workspace</string>
        </property>
       </item>
      </widget>
     </item>
     <item row="7" column="0">
      <widget class="QLabel" name="holdEnabledLabel">
       <property name="text">
        <string>Layout changes:</string>
       </property>
       <property name="buddy">
        <cstring>kcfg_holdEnabled</cstring>
       </property>
      </widget>
     </item>
     <item row="7" column="1">
      <widget class="QCheckBox" name="kcfg_holdEnabled">
       <property name="text">
        <string>Wait for every window to resize (needs the kwin-i3 plugins)</string>
       </property>
       <property name="toolTip">
        <string>Holds the old picture while windows resize, so the wallpaper doesn't flash through.</string>
       </property>
      </widget>
     </item>
     <item row="8" column="0">
      <widget class="QLabel" name="holdTimeoutMsLabel">
       <property name="text">
