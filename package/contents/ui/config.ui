      <widget class="QComboBox" name="kcfg_defaultOrientation">
       <property name="kcfg_property" stdset="0">
        <cstring>currentText</cstring>
       </property>
       <property name="toolTip">
        <string>i3's default_orientation. auto: side by side, unless the monitor is taller than wide. For workspaces created after the change.</string>
       </property>
       <item>
        <property name="text">
         <string>auto</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>horizontal</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>vertical</string>
        </property>
       </item>
      </widget>
     </item>
